class SklearnSentimentAnalyzer:
    """
    Класс для анализа тональности с использованием scikit-learn моделей
    Поддерживает обучение и предсказание для русских текстов
    """
    
    def __init__(self, model_type='logistic_regression'):
        """
        Инициализация анализатора
        
        Parameters:
        model_type: str - тип модели ('logistic_regression', 'svm', 'random_forest')
        """
        self.model_type = model_type
        self.model = None
        self.vectorizer = TfidfVectorizer(
            max_features=10000,
            ngram_range=(1, 3),
            min_df=2,
            max_df=0.8,
            sublinear_tf=True
        )
        self.is_trained = False
        self.label_mapping = {'negative': 0, 'neutral': 1, 'positive': 2}
        self.reverse_mapping = {0: 'Negative', 1: 'Neutral', 2: 'Positive'}
        
    def create_pipeline(self):
        """Создает pipeline с выбранной моделью"""
        if self.model_type == 'logistic_regression':
            classifier = LogisticRegression(
                C=1.0,
                max_iter=1000,
                random_state=42,
                class_weight='balanced'
            )
        elif self.model_type == 'svm':
            classifier = SVC(
                C=1.0,
                kernel='linear',
                probability=True,
                random_state=42,
                class_weight='balanced'
            )
        elif self.model_type == 'random_forest':
            classifier = RandomForestClassifier(
                n_estimators=200,
                max_depth=20,
                random_state=42,
                class_weight='balanced',
                n_jobs=-1
            )
        else:
            raise ValueError(f"Неизвестный тип модели: {self.model_type}")
        
        self.model = Pipeline([
            ('tfidf', self.vectorizer),
            ('classifier', classifier)
        ])
        
    def train(self, texts, labels, test_size=0.2, save_path=None):
        """
        Обучение модели
        
        Parameters:
        texts: list - список текстов для обучения
        labels: list - список меток ('Positive', 'Neutral', 'Negative')
        test_size: float - размер тестовой выборки
        save_path: str - путь для сохранения модели
        """
        logger.info(f"Начало обучения модели {self.model_type}...")
        
        # Преобразование меток в числовой формат
        y = [self.label_mapping[label.lower()] for label in labels]
        
        # Разделение на обучающую и тестовую выборки
        X_train, X_test, y_train, y_test = train_test_split(
            texts, y, test_size=test_size, random_state=42, stratify=y
        )
        
        # Создание и обучение модели
        self.create_pipeline()
        self.model.fit(X_train, y_train)
        
        # Оценка на тестовой выборке
        y_pred = self.model.predict(X_test)
        accuracy = accuracy_score(y_test, y_pred)
        
        logger.info(f"Модель {self.model_type} обучена")
        logger.info(f"Точность на тестовой выборке: {accuracy:.4f}")
        logger.info("\n" + classification_report(
            y_test, y_pred, 
            target_names=['Negative', 'Neutral', 'Positive']
        ))
        
        # Сохранение модели
        if save_path:
            self.save_model(save_path)
            
        self.is_trained = True
        
        return accuracy
    
    def predict(self, text):
        """
        Предсказание тональности для одного текста
        
        Returns:
        tuple: (score, sentiment_label, confidence)
        """
        if not self.is_trained:
            logger.warning("Модель не обучена. Возвращаю нейтральный результат.")
            return 3, "Neutral", 0.0
        
        try:
            # Получение предсказания
            pred_class = self.model.predict([text])[0]
            
            # Получение вероятностей (если модель поддерживает)
            if hasattr(self.model, 'predict_proba'):
                proba = self.model.predict_proba([text])[0]
                confidence = proba[pred_class]
            else:
                confidence = 0.0
            
            # Преобразование в нужный формат
            sentiment_label = self.reverse_mapping[pred_class]
            
            # Преобразование в score (1,3,5)
            if sentiment_label == "Positive":
                score = 5
            elif sentiment_label == "Negative":
                score = 1
            else:
                score = 3
            
            return score, sentiment_label, confidence
            
        except Exception as e:
            logger.error(f"Ошибка в предсказании: {e}")
            return 3, "Neutral", 0.0
    
    def predict_batch(self, texts):
        """
        Предсказание для нескольких текстов
        """
        if not self.is_trained:
            logger.warning("Модель не обучена. Возвращаю нейтральные результаты.")
            return [(3, "Neutral", 0.0) for _ in texts]
        
        try:
            predictions = self.model.predict(texts)
            results = []
            
            for pred in predictions:
                sentiment = self.reverse_mapping[pred]
                if sentiment == "Positive":
                    score = 5
                elif sentiment == "Negative":
                    score = 1
                else:
                    score = 3
                results.append((score, sentiment, 0.0))
            
            return results
            
        except Exception as e:
            logger.error(f"Ошибка в пакетном предсказании: {e}")
            return [(3, "Neutral", 0.0) for _ in texts]
    
    def save_model(self, filepath):
        """Сохранение модели"""
        try:
            joblib.dump(self.model, filepath)
            logger.info(f"Модель сохранена в {filepath}")
        except Exception as e:
            logger.error(f"Ошибка сохранения модели: {e}")
    
    def load_model(self, filepath):
        """Загрузка модели"""
        try:
            self.model = joblib.load(filepath)
            self.is_trained = True
            logger.info(f"Модель загружена из {filepath}")
        except Exception as e:
            logger.error(f"Ошибка загрузки модели: {e}")


